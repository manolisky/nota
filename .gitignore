# Gitignore for Nota project

# LaTeX generated files
*.aux
*.log
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.nota.aux
*.out

# Python virtual environment
.venv/

# Auto-generated nota files
*notaaux/
*-nota/
examples/*/main.pdf

# Go build products
bin/
scripts/nota-render/nota-render

# l3build generated workspace
build/

# Auto-generated other files
*_grid.png

# macOS specific files
.DS_Store
pdf_to_grid.sh
resize_image.sh
