# Gitignore for Nota project

# LaTeX generated files
*.aux
*.log
*.fdb_latexmk
*.fls
*.synctex.gz
*.synctex
*.toc
*.nota.aux
*.out
*.xdv

# Auto-generated nota files
*-nota/
examples/**/main.pdf

# Go build products
bin/
nota-render/nota-render
tools/nota-gallery/nota-gallery
*.test
coverage.out

# l3build generated workspace
build/

# Preview scratch images (not showcase/gallery)
temp_*.png

# Editor / OS
.vscode/
.DS_Store
