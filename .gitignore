# Gitignore for Nota project

# LaTeX generated files
*.aux
*.log
*.fdb_latexmk
*.fls
*.synctex.gz
*.synctex
*.toc
*.nota.aux
*.out
*.xdv

# Auto-generated nota files
*-nota/
examples/*/main.pdf

# Go build products
bin/
scripts/nota-render/nota-render
*.test
coverage.out

# l3build generated workspace
build/

# Preview grids and temp images
*_grid*.png
temp_*.png

# macOS
.DS_Store
